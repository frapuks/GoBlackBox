{
  "name": "@blackbox/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --legacy-watch --watch src --watch ../../packages/shared/src --ext ts,sql --exec tsx src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blackbox/shared": "*",
    "@fastify/cookie": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/sensible": "^6.0.1",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.6.3"
  }
}
