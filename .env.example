# Copie ce fichier en .env avant le premier `docker compose up`.

POSTGRES_USER=blackbox
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=blackbox

# Secret de signature des JWT. En prod : openssl rand -hex 32
JWT_SECRET=dev-secret-not-for-production

# production  → cookie de session Secure (exige HTTPS), logs JSON, seed refusé
# development → cookie non-Secure, logs lisibles, `npm run seed` autorisé
#
# Sur le Raspberry Pi : production.
# En local, où l'app est servie en http://localhost:6012 : development —
# sinon le navigateur refuse le cookie et la connexion échoue silencieusement.
NODE_ENV=production

# Notifications push (VAPID). Laisser vide desactive proprement les
# notifications : l'app fonctionne, l'interrupteur n'apparait pas.
# Generer une fois par installation :
#   docker compose exec api node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(k.publicKey);console.log(k.privateKey)"
# Les changer invalide TOUS les abonnements existants.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ton-email@exemple.fr
